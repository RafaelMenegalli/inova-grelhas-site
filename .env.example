# Banco de dados (Neon PostgreSQL) — use a connection string "pooled" do painel da Neon
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# URL pública do site (sem barra no final)
# Em produção use https://www.inovagrelhaslineares.com.br (sem a variável, o código já usa esse endereço)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storage de imagens — Supabase Storage (bucket público)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Secret key: somente servidor, nunca expor no navegador
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="inova-images"

# WhatsApp de contato (só dígitos, com DDI+DDD, ex.: 5519999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# URL do vídeo vertical 9:16 do hero (opcional)
NEXT_PUBLIC_HERO_VIDEO_URL=""

# Acesso ao painel /admin
ADMIN_USER=""
ADMIN_PASSWORD=""
# Chave para assinar o cookie de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=""

# Google Tag Manager (ex.: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=""

# Dados fiscais exibidos no rodapé
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_CNPJ=""
